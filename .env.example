APP_BIND=127.0.0.1

# Optional OpenAI-compatible inference endpoint (Brev + vLLM / NVIDIA NIM).
# This must end in /v1. Secrets stay on the backend, never in VITE_* variables.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
