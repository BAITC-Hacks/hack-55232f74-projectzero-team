# Port and bind address of the web application. Use 0.0.0.0 for a remote demo.
APP_PORT=8080
APP_BIND=127.0.0.1

# Optional OpenAI-compatible inference endpoint (Brev + vLLM / NVIDIA NIM).
# This must end in /v1. Secrets stay on the backend, never in VITE_* variables.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_JSON_MODE=true

# Optional GPU deployment, used only with compose.brev.yaml.
BREV_MODEL=Qwen/Qwen3-4B-Instruct-2507
